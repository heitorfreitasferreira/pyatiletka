#!/usr/bin/env bash
#MISE description="Build the project"
#MISE depends=["setup"]
#MISE sources=["src/**/*"]
#MISE outputs=["dist/index.js", "dist/index.d.ts", "dist/cli.js"]

set -e

# `@opencode/plugin` fica external: e dependency e o host resolve a copia
# instalada, sem duplicar effect e @opencode/client no bundle. O
# `@opencode-ai/plugin` (v1) segue empacotado para o v1 nao depender disso.
bun build ./src/index.ts --outdir dist --target bun --external @opencode/plugin

# O CLI nao importa `src/index.ts`, entao nao arrasta o plugin do opencode. Alvo
# node porque o binario roda por `npx`, nao pelo bun.
bun build ./src/cli/main.ts --outfile dist/cli.js --target node --external @opencode/plugin
chmod +x dist/cli.js

# Declaracoes para o `exports.types` do package.json. O bun nao emite .d.ts,
# entao o tsc gera so as declaracoes em cima do mesmo codigo.
tsc -p tsconfig.build.json
